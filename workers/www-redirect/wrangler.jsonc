// Redirect-only Worker for www.amit.so. Deployed by .github/workflows/deploy.yml on pushes to main.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "amit-so-www",
  "main": "index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  // In CI (non-TTY), wrangler replaces the existing www DNS record (formerly Vercel's CNAME) with this custom domain.
  "routes": [
    { "pattern": "www.amit.so", "custom_domain": true }
  ]
}
