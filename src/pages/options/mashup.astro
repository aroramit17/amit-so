---
// UI option B — "Clay × Salesforce × Claude": Amit's portfolio as a CRM record page.
// Borrows visual language only (record layout, path, enrichment table, warm conversation); no third-party logos or names in the UI.
// Preview only (noindex, not in sitemap/llms.txt).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SITE_DATA from '../../data/site.js';
import { currentWork } from '../../data/home.js';
import portrait from '../../../public/amit-headshot.png';
import '../../styles/option-mashup.css';

const invoca = SITE_DATA.experience[0];
const path = [
  { stage: 'Hospitality', when: 'Before 2015' },
  { stage: 'Salesforce admin', when: '2015' },
  { stage: 'Consulting', when: '2018' },
  { stage: 'Business systems', when: '2021' },
  { stage: 'RevOps', when: '2025' },
  { stage: 'GTM AI', when: '2026', current: true },
];
const results = [
  { company: 'DHI Group', role: 'Director, Business Systems', change: 'Rebuilt pipeline and forecasting during a Classic to Lightning migration', result: '+25% forecast accuracy', href: '/dhi-case-study', tint: 'lilac' },
  { company: 'webAI', role: 'Revenue Operations Manager', change: 'Closed-loop ICP scoring across HubSpot, Clay, Apify, and Claude', result: 'Every inbound lead scored and routed the same day', href: '/webai-case-study', tint: 'mint' },
  { company: 'Slalom', role: 'Salesforce Consultant', change: 'Enterprise Salesforce delivery in Financial Services', result: '98% client satisfaction, 95% project success', tint: 'butter' },
  { company: 'Avangrid', role: 'Sr. Salesforce Administrator', change: 'Salesforce migration for two gas corporations', result: '$750K migration, +30% efficiency', tint: 'peach' },
];
const questions = [
  { q: 'What do you do at Invoca?', a: `I'm the ${invoca.role}: I build AI-assisted GTM systems and workflows for the revenue team, and I own CPQ and deal desk operations.` },
  { q: 'Do you teach this?', a: 'Yes. Claude Code for Salesforce is my course for admins and developers, and the 1:1 AI Website Build Intensive is a paid 90-minute working session.' },
  { q: 'Where are you based?', a: 'Prosper, Texas. I help run ClawPlex, a hands-on meetup for AI builders in Dallas–Fort Worth.' },
  { q: 'What is the fastest way to talk?', a: 'Book a 30-minute call. Bring the messy version of the system and we will figure out what it needs next.' },
];
---
<BaseLayout
  title="Option B: Record Page | Amit Arora"
  description="Design preview for amit.so: Amit Arora's portfolio laid out as a CRM record page."
  canonical="https://amit.so/options/mashup"
  showFloatingCta={false}
>
  <meta slot="head" name="robots" content="noindex" />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..700,100&family=Instrument+Sans:wght@400;500;600;700&display=swap" />

  <div class="mx">
    <a href="#mx-main" class="skip-link">Skip to content</a>
    <header class="mx-app">
      <a href="/" class="mx-logo"><span aria-hidden="true">a</span>amit.so</a>
      <nav class="mx-tabs" aria-label="Primary">
        <a href="#mx-results" aria-current="page">Overview</a>
        <a href="#mx-history">Work history</a>
        <a href="#mx-questions">Questions</a>
      </nav>
      <a href="/interview" class="mx-btn mx-btn--brand">Book a call</a>
    </header>

    <main id="mx-main" class="mx-page">
      <section class="mx-highlights" aria-labelledby="mx-title">
        <div class="mx-avatar">
          <Image src={portrait} alt="Amit Arora" widths={[160, 320]} sizes="160px" width={320} height={320} format="webp" loading="eager" />
        </div>
        <div class="mx-headline">
          <p class="mx-record">Amit Arora</p>
          <h1 id="mx-title">I fix the systems behind your pipeline.</h1>
          <p class="mx-sub">{SITE_DATA.sub}</p>
        </div>
        <dl class="mx-fields">
          <div><dt>Title</dt><dd>{invoca.role}</dd></div>
          <div><dt>Company</dt><dd>Invoca</dd></div>
          <div><dt>Location</dt><dd>Prosper, Texas</dd></div>
          <div><dt>Certifications</dt><dd>8× Salesforce</dd></div>
        </dl>
        <div class="mx-actions">
          <a href="/interview" class="mx-btn mx-btn--brand">Book a 30-minute call</a>
          <a href="#mx-results" class="mx-btn">See the results</a>
        </div>
      </section>

      <section class="mx-path-wrap" aria-labelledby="mx-path-title">
        <h2 id="mx-path-title" class="mx-sr">Career path</h2>
        <ol class="mx-path">
          {path.map((p) => (
            <li class={p.current ? 'is-current' : 'is-done'} aria-current={p.current ? 'step' : undefined}>
              <span class="mx-stage">{p.stage}</span>
              <span class="mx-when">{p.when}</span>
            </li>
          ))}
        </ol>
      </section>

      <div class="mx-columns">
        <div class="mx-main">
          <section id="mx-results" class="mx-card" aria-labelledby="mx-results-title">
            <header class="mx-card-head">
              <h2 id="mx-results-title">Results</h2>
              <p>Four roles, four outcomes. Two have full write-ups.</p>
            </header>
            <div class="mx-table-wrap" role="region" aria-labelledby="mx-results-title" tabindex="0">
              <table class="mx-table">
                <thead>
                  <tr><th scope="col">Company</th><th scope="col">What changed</th><th scope="col">Result</th><th scope="col">Write-up</th></tr>
                </thead>
                <tbody>
                  {results.map((r) => (
                    <tr>
                      <th scope="row"><span class="mx-co">{r.company}</span><span class="mx-role">{r.role}</span></th>
                      <td>{r.change}</td>
                      <td><span class={`mx-chip mx-chip--${r.tint}`}>{r.result}</span></td>
                      <td>{r.href ? <a href={r.href}>Case study</a> : <span class="mx-none" aria-label="No write-up">—</span>}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <section class="mx-card" aria-labelledby="mx-now-title">
            <header class="mx-card-head"><h2 id="mx-now-title">Working on now</h2></header>
            <ul class="mx-now" role="list">
              {currentWork.map((w) => (
                <li>
                  <a href={w.href} target="_blank" rel="noopener noreferrer">
                    <span class="mx-now-title">{w.title}</span>
                    <span class="mx-now-role">{w.role}</span>
                    <span class="mx-now-copy">{w.copy}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section id="mx-history" class="mx-card" aria-labelledby="mx-history-title">
            <header class="mx-card-head"><h2 id="mx-history-title">Work history <span>({SITE_DATA.experience.length})</span></h2></header>
            <ul class="mx-history" role="list">
              {SITE_DATA.experience.map((job) => (
                <li>
                  <details>
                    <summary>
                      <span class="mx-co">{job.company}</span>
                      <span class="mx-role">{job.role || job.scope}</span>
                      <span class="mx-dates">{job.dates}</span>
                    </summary>
                    <p>{job.summary}</p>
                  </details>
                </li>
              ))}
            </ul>
          </section>

          <section id="mx-questions" class="mx-chat" aria-labelledby="mx-questions-title">
            <h2 id="mx-questions-title">Questions people ask me</h2>
            <dl>
              {questions.map((item) => (
                <div class="mx-turn">
                  <dt class="mx-q">{item.q}</dt>
                  <dd class="mx-a">{item.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>

        <aside class="mx-side" aria-label="Details">
          <section class="mx-card" aria-labelledby="mx-details-title">
            <header class="mx-card-head"><h2 id="mx-details-title">Contact</h2></header>
            <dl class="mx-details">
              <div><dt>Email</dt><dd><a href={`mailto:${SITE_DATA.social.email}`}>{SITE_DATA.social.email}</a></dd></div>
              <div><dt>LinkedIn</dt><dd><a href={SITE_DATA.social.linkedin} target="_blank" rel="noopener noreferrer">amit-arora17</a></dd></div>
              <div><dt>YouTube</dt><dd><a href={SITE_DATA.social.youtube} target="_blank" rel="noopener noreferrer">@ai-withamit</a></dd></div>
              <div><dt>Call</dt><dd><a href="/interview">30 minutes, pick a time</a></dd></div>
            </dl>
          </section>
          <section class="mx-card" aria-labelledby="mx-certs-title">
            <header class="mx-card-head"><h2 id="mx-certs-title">Certifications <span>({SITE_DATA.certifications.length})</span></h2></header>
            <ul class="mx-tags" role="list">{SITE_DATA.certifications.map((c) => <li>{c}</li>)}</ul>
          </section>
          <section class="mx-card" aria-labelledby="mx-projects-title">
            <header class="mx-card-head"><h2 id="mx-projects-title">Beyond the role</h2></header>
            <ul class="mx-links" role="list">
              {SITE_DATA.projects.map((p) => (
                <li><a href={p.link} target="_blank" rel="noopener noreferrer">{p.title}</a><span>{p.type}</span></li>
              ))}
            </ul>
          </section>
          <section class="mx-card mx-origin" aria-labelledby="mx-origin-title">
            <h2 id="mx-origin-title">Before revenue systems, I ran hotels.</h2>
            <p>Hospitality taught me that systems only work when people actually use them.</p>
          </section>
        </aside>
      </div>
    </main>

    <footer class="mx-foot">
      <span>© {new Date().getFullYear()} Amit Arora</span>
      <a href="/options">Compare options</a>
      <a href="/privacy">Privacy</a>
    </footer>
  </div>
</BaseLayout>
