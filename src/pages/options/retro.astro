---
// UI option A — "Retro". Preview only (noindex, not in sitemap/llms.txt).
import BaseLayout from '../../layouts/BaseLayout.astro';
import SITE_DATA from '../../data/site.js';
import { currentWork } from '../../data/home.js';
import '../../styles/option-retro.css';

const scores = [
  { label: 'Forecast accuracy', value: '+25%', where: 'DHI Group' },
  { label: 'Client satisfaction', value: '98%', where: 'Slalom' },
  { label: 'Project success rate', value: '95%', where: 'Slalom' },
  { label: 'CRM migration led', value: '$750K', where: 'Avangrid' },
  { label: 'Operational efficiency', value: '+30%', where: 'Avangrid' },
  { label: 'Salesforce certifications', value: '8×', where: 'Admin to Agentforce' },
];
const cartridgeColors = ['#2763FF', '#F07866', '#3FB98C'];
---
<BaseLayout
  title="Option A: Retro | Amit Arora"
  description="Design preview for amit.so: a retro computing take on Amit Arora's portfolio."
  canonical="https://amit.so/options/retro"
  showFloatingCta={false}
>
  <meta slot="head" name="robots" content="noindex" />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=VT323&display=swap" />

  <div class="rt">
    <a href="#rt-main" class="skip-link">Skip to content</a>
    <header class="rt-bar">
      <a href="/" class="rt-brand"><span class="rt-stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></span>amit.so</a>
      <nav aria-label="Primary">
        <a href="#rt-work">Work</a>
        <a href="#rt-career">Career</a>
        <a href="#rt-projects">Projects</a>
        <a href="/interview" class="rt-key rt-key--small">Book a call</a>
      </nav>
    </header>

    <main id="rt-main">
      <section class="rt-hero" aria-labelledby="rt-title">
        <div class="rt-monitor">
          <div class="rt-glass">
            <p class="rt-prompt">C:\AMIT&gt; whoami</p>
            <p class="rt-who">Amit Arora · {SITE_DATA.experience[0].role}, Invoca</p>
            <h1 id="rt-title">I fix the systems behind your pipeline<span class="rt-cursor" aria-hidden="true">_</span></h1>
          </div>
          <div class="rt-chin">
            <span class="rt-badge">AA-1989</span>
            <span class="rt-knobs" aria-hidden="true"><i></i><i></i></span>
            <span class="rt-led" aria-hidden="true"></span>
          </div>
        </div>

        <aside class="rt-scores" aria-labelledby="rt-scores-title">
          <h2 id="rt-scores-title">Scoreboard</h2>
          <dl>
            {scores.map((s) => (
              <div class="rt-score">
                <dt>{s.label}<small>{s.where}</small></dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </aside>

        <div class="rt-intro">
          <p>{SITE_DATA.sub}</p>
          <div class="rt-actions">
            <a href="/interview" class="rt-key">Book a 30-minute call</a>
            <a href="#rt-work" class="rt-key rt-key--plain">See the work</a>
          </div>
          <p class="rt-where">Prosper, Texas. Dallas–Fort Worth.</p>
        </div>
      </section>

      <section id="rt-work" class="rt-section" aria-labelledby="rt-work-title">
        <h2 id="rt-work-title" class="rt-h2">Case studies</h2>
        <div class="rt-manuals">
          {SITE_DATA.caseStudies.map((c) => (
            <article class="rt-manual">
              <p class="rt-manual-tag">{c.company}</p>
              <h3>{c.title}</h3>
              <p>{c.blurb}</p>
              <p class="rt-manual-outcome"><strong>Outcome:</strong> {c.outcome}</p>
              <a href={`/${c.slug}`}>Read the case study</a>
            </article>
          ))}
        </div>
      </section>

      <section class="rt-section" aria-labelledby="rt-now-title">
        <h2 id="rt-now-title" class="rt-h2">Currently loaded</h2>
        <ul class="rt-carts" role="list">
          {currentWork.map((w, i) => (
            <li>
              <a class="rt-cart" href={w.href} target="_blank" rel="noopener noreferrer" style={`--c:${cartridgeColors[i % 3]}`}>
                <span class="rt-cart-label">
                  <span class="rt-cart-title">{w.title}</span>
                  <span class="rt-cart-role">{w.role}</span>
                </span>
                <span class="rt-cart-copy">{w.copy}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="rt-career" class="rt-section" aria-labelledby="rt-career-title">
        <h2 id="rt-career-title" class="rt-h2">Career log</h2>
        <ol class="rt-log">
          {SITE_DATA.experience.map((job) => (
            <li>
              <span class="rt-log-date">{job.dates}</span>
              <div>
                <h3>{job.company} <span>{job.role || job.scope}</span></h3>
                <p>{job.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="rt-origin" aria-labelledby="rt-origin-title">
        <h2 id="rt-origin-title">Before I built revenue systems, I ran hotels.</h2>
        <p>
          Hospitality taught me that systems only work when people actually use them. When the lobby is full,
          the team needs a clear next step and someone who can fix the problem. That is still how I operate.
        </p>
        <p class="rt-certs"><strong>8× Salesforce certified:</strong> {SITE_DATA.certifications.join(', ')}.</p>
      </section>

      <section id="rt-projects" class="rt-section" aria-labelledby="rt-projects-title">
        <h2 id="rt-projects-title" class="rt-h2">Beyond the role</h2>
        <ul class="rt-projects" role="list">
          {SITE_DATA.projects.map((p) => (
            <li>
              <a href={p.link} target="_blank" rel="noopener noreferrer">
                <span class="rt-project-title">{p.title}</span>
                <span class="rt-project-type">{p.type}</span>
                <span class="rt-project-desc">{p.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="rt-contact" aria-labelledby="rt-contact-title">
        <h2 id="rt-contact-title">Have a revenue system people have stopped trusting?</h2>
        <p>Book 30 minutes to talk shop about a revenue system, a GTM build, or what you are shipping with Claude Code.</p>
        <div class="rt-actions">
          <a href="/interview" class="rt-key">Book a 30-minute call</a>
          <a href={`mailto:${SITE_DATA.social.email}`} class="rt-link">{SITE_DATA.social.email}</a>
          <a href={SITE_DATA.social.linkedin} class="rt-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </section>
    </main>

    <footer class="rt-foot">
      <span>© {new Date().getFullYear()} Amit Arora</span>
      <a href="/options">Compare options</a>
      <a href="/privacy">Privacy</a>
    </footer>
  </div>
</BaseLayout>
