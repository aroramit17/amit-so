---
// /explore — vertical slice of the "playable workshop" redesign.
// Preview only: noindex, not in sitemap.xml or llms.txt until Amit approves it.
// Everything a visitor needs is HTML below; the 3D scene is an optional layer.
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATIONS } from '../data/workshop.js';
import '../styles/explore.css';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Explore the workshop',
  url: 'https://amit.so/explore',
  description: "An interactive workshop view of Amit Arora's work: projects, GTM systems case studies, teaching, and contact.",
  isPartOf: { '@type': 'WebSite', name: 'Amit Arora', url: 'https://amit.so' },
  about: { '@type': 'Person', name: 'Amit Arora', url: 'https://amit.so' },
});

// Poster pixel map: same rule the 3D scene uses for its first frame.
const PAPER = '#F5F1E8';
const INK = '#101C2D';
const mixHex = (a: string, b: string, t: number) => {
  const pa = [1, 3, 5].map((i) => parseInt(a.slice(i, i + 2), 16));
  const pb = [1, 3, 5].map((i) => parseInt(b.slice(i, i + 2), 16));
  return '#' + pa.map((v, k) => Math.round(v + (pb[k] - v) * t).toString(16).padStart(2, '0')).join('');
};
const STATION_XZ: Record<string, [number, number]> = {
  'build-lab': [-3.1, -0.4],
  'systems-engine': [0, -1.9],
  'broadcast-booth': [3.1, -0.4],
  'meet-amit': [0, 1.75],
};
const cols = 20, rows = 14, cell = 10;
const pixels: { x: number; y: number; fill: string }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const x = -5 + 0.5 * (c + 0.5);
    const z = -3.5 + 0.5 * (r + 0.5);
    const edge = c === 0 || r === 0 || c === cols - 1 || r === rows - 1;
    const st = STATIONS.find((s) => Math.abs(x - STATION_XZ[s.id][0]) < 1.2 && Math.abs(z - STATION_XZ[s.id][1]) < 0.9);
    const fill = edge ? INK : st ? mixHex(PAPER, st.accent, st.accent === INK ? 0.28 : 0.55) : (c + r) % 2 ? '#EFE7D6' : '#E8DFCA';
    pixels.push({ x: 30 + c * cell, y: 62 + r * cell, fill });
  }
}
---
<BaseLayout
  title="Explore the Workshop | Amit Arora"
  description="Step into Amit Arora's workshop: projects built with Claude, GTM systems case studies, teaching, and a direct line to book a 30-minute call."
  canonical="https://amit.so/explore"
  jsonLd={jsonLd}
  showFloatingCta={false}
>
  <meta slot="head" name="robots" content="noindex" />

  <div class="ws" data-mode="shell">
    <a href="#stations" class="ws-skip">Skip to stations</a>

    <header class="ws-bar">
      <a href="/" class="ws-brand" aria-label="Amit Arora home">amit.so<span aria-hidden="true">●</span></a>
      <nav class="ws-nav" aria-label="Primary">
        <a href="/#case-studies">Work</a>
        <a href="/#about">About</a>
        <a href="https://ccforsf.com" target="_blank" rel="noopener noreferrer">Learn</a>
        <a href="/interview" class="ws-contact">Contact</a>
      </nav>
      <button type="button" class="ws-settings-btn" aria-expanded="false" aria-controls="ws-settings" hidden>
        <span aria-hidden="true">⚙</span><span class="ws-settings-label">Settings</span>
      </button>
    </header>

    <div id="ws-settings" class="ws-settings" role="group" aria-label="Experience settings" hidden>
      <fieldset>
        <legend>Graphics</legend>
        <label><input type="radio" name="ws-quality" value="auto" checked /> Automatic</label>
        <label><input type="radio" name="ws-quality" value="standard" /> Standard</label>
        <label><input type="radio" name="ws-quality" value="lite" /> Lite</label>
      </fieldset>
      <fieldset>
        <legend>Motion</legend>
        <label><input type="radio" name="ws-motion" value="system" checked /> Match my device</label>
        <label><input type="radio" name="ws-motion" value="reduce" /> Reduced</label>
        <label><input type="radio" name="ws-motion" value="full" /> Full</label>
      </fieldset>
      <p class="ws-settings-note">Sound is off. This preview has no audio.</p>
    </div>

    <div class="ws-stage" hidden>
      <canvas class="ws-canvas" role="img" aria-label="A 3D workshop with four stations. Use the station buttons to open each one."></canvas>
      <div class="ws-hud">
        <button type="button" class="ws-hud-btn" data-exit aria-label="Exit workshop">← Exit <span class="ws-sm-hide">workshop</span></button>
        <div class="ws-hud-right">
          <button type="button" class="ws-hud-btn" data-skip>Skip intro</button>
          <button type="button" class="ws-hud-btn" data-overview hidden>Reset <span class="ws-sm-hide">view</span></button>
          <button type="button" class="ws-hud-btn" data-replay hidden>Replay <span class="ws-sm-hide">opening</span></button>
        </div>
      </div>
      <p class="ws-hint" hidden>Tap a station, or use the labels.</p>
      <div class="ws-loading" role="status" aria-live="polite" hidden>
        <p class="ws-loading-title">Building the workshop…</p>
        <p class="ws-loading-slow" hidden>
          This is taking longer than expected.
          <button type="button" class="ws-link-btn" data-try-lite>Try Lite mode</button>
        </p>
        <div class="ws-loading-actions">
          <button type="button" class="ws-hud-btn" data-cancel>Cancel</button>
          <a href="/#case-studies" class="ws-hud-btn">Continue reading</a>
        </div>
      </div>
    </div>

    <main id="main-content" class="ws-main">
      <section class="ws-hero" aria-labelledby="ws-title">
        <div class="ws-hero-copy">
          <p class="ws-eyebrow">Amit Arora · GTM engineer &amp; RevOps</p>
          <h1 id="ws-title">I build the systems behind your pipeline. <em>Come see how they run.</em></h1>
          <p class="ws-lede">
            Ten-plus years across Salesforce, RevOps, and AI GTM systems, laid out as a small workshop.
            Explore it, or skip straight to the work.
          </p>
          <div class="ws-routes">
            <button type="button" class="ws-btn ws-btn--primary" data-explore hidden>Explore the workshop</button>
            <a href="/#case-studies" class="ws-btn">View my work</a>
          </div>
          <p class="ws-status" role="status" aria-live="polite"></p>
        </div>
        <figure class="ws-poster" aria-hidden="true">
          <svg viewBox="0 0 260 330" role="presentation" focusable="false">
            <rect x="12" y="20" width="236" height="300" rx="14" fill={INK} />
            <rect x="24" y="30" width="212" height="22" rx="4" fill="#1B2A44" />
            <text x="130" y="46" text-anchor="middle" class="ws-poster-marquee">AMIT PLAYABLE SYSTEMS</text>
            {pixels.map((p) => <rect x={p.x} y={p.y} width={cell - 1} height={cell - 1} fill={p.fill} />)}
            <rect x="12" y="214" width="236" height="106" rx="14" fill="#16243A" />
            <circle cx="186" cy="252" r="15" fill="#F07866" />
            <rect x="70" y="250" width="5" height="22" rx="2" fill="#9AA3B5" />
            <circle cx="72.5" cy="246" r="9" fill="#2763FF" />
            <rect x="96" y="292" width="68" height="8" rx="4" fill="#24344F" />
          </svg>
        </figure>
      </section>

      <section id="stations" class="ws-stations" aria-labelledby="stations-title">
        <div class="ws-stations-head">
          <h2 id="stations-title">Four stations</h2>
          <p>Each one opens real work. Nothing here is locked behind the 3D view.</p>
        </div>
        <ul class="ws-station-list" role="list">
          {STATIONS.map((s) => (
            <li>
              <button
                type="button"
                class="ws-station-btn"
                data-station={s.id}
                aria-controls={`panel-${s.id}`}
                aria-expanded="false"
                style={`--accent:${s.accent}`}
              >
                <span class="ws-station-dot" aria-hidden="true"></span>
                <span class="ws-station-name">{s.name}</span>
                <span class="ws-station-kicker">{s.kicker}</span>
              </button>
            </li>
          ))}
        </ul>

        <div class="ws-panels">
          {STATIONS.map((s) => (
            <section
              id={`panel-${s.id}`}
              class="ws-panel"
              data-panel={s.id}
              aria-labelledby={`panel-${s.id}-title`}
              tabindex="-1"
              style={`--accent:${s.accent}`}
            >
              <header class="ws-panel-head">
                <p class="ws-panel-kicker">{s.kicker}</p>
                <h3 id={`panel-${s.id}-title`}>{s.name}</h3>
                <button type="button" class="ws-panel-close" data-close aria-label={`Close ${s.name}`} hidden>Close</button>
              </header>
              <p class="ws-panel-summary">{s.summary}</p>
              <ul class="ws-items" role="list">
                {s.items.map((item) => (
                  <li class="ws-item">
                    <p class="ws-item-meta">{item.meta}</p>
                    <h4>{item.title}</h4>
                    <p>{item.body}</p>
                    <a
                      href={item.href}
                      {...(/^https?:/.test(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >{item.cta} <span aria-hidden="true">→</span></a>
                  </li>
                ))}
              </ul>
              {s.contact && (
                <p class="ws-panel-contact">
                  <a href={`mailto:${s.contact.email}`}>{s.contact.email}</a>
                  <a href={s.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
                </p>
              )}
              {s.note && <p class="ws-panel-note">{s.note}</p>}
            </section>
          ))}
        </div>
      </section>
    </main>

  </div>

  <script>
    import type { WorkshopHandle, StationId, LabelPositions } from '../scripts/workshop-scene';

    const root = document.querySelector<HTMLElement>('.ws')!;
    root.classList.add('js');
    const stage = root.querySelector<HTMLElement>('.ws-stage')!;
    let canvas = root.querySelector<HTMLCanvasElement>('.ws-canvas')!;
    const loading = root.querySelector<HTMLElement>('.ws-loading')!;
    const slow = root.querySelector<HTMLElement>('.ws-loading-slow')!;
    const statusEl = root.querySelector<HTMLElement>('.ws-status')!;
    const hint = root.querySelector<HTMLElement>('.ws-hint')!;
    const exploreBtn = root.querySelector<HTMLButtonElement>('[data-explore]')!;
    const skipBtn = root.querySelector<HTMLButtonElement>('[data-skip]')!;
    const overviewBtn = root.querySelector<HTMLButtonElement>('[data-overview]')!;
    const replayBtn = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    const settingsBtn = root.querySelector<HTMLButtonElement>('.ws-settings-btn')!;
    const settings = root.querySelector<HTMLElement>('#ws-settings')!;
    const hero = root.querySelector<HTMLElement>('.ws-hero')!;
    const stationBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-station]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const IDS = stationBtns.map((b) => b.dataset.station as StationId);

    // ─── Preferences (local only; storage failure never blocks access) ───
    const store = {
      get(k: string, d: string) { try { return localStorage.getItem(k) ?? d; } catch { return d; } },
      set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
    };
    const prefs = { quality: store.get('ws-quality', 'auto'), motion: store.get('ws-motion', 'system') };
    root.querySelectorAll<HTMLInputElement>('input[name="ws-quality"]').forEach((i) => { i.checked = i.value === prefs.quality; });
    root.querySelectorAll<HTMLInputElement>('input[name="ws-motion"]').forEach((i) => { i.checked = i.value === prefs.motion; });
    const systemReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reducedMotion = () => (prefs.motion === 'reduce' ? true : prefs.motion === 'full' ? false : systemReduce.matches);
    const resolveQuality = () => {
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      if (prefs.quality === 'lite' || (prefs.quality === 'auto' && saveData)) return { quality: 'lite' as const, auto: false };
      return { quality: 'standard' as const, auto: prefs.quality === 'auto' };
    };
    root.classList.toggle('ws-reduce', reducedMotion());

    // ─── Capability check (feature, not browser name) ───
    function hasWebGL2() {
      try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
    }

    // ─── State ───
    type Mode = 'shell' | 'loading' | 'workshop';
    let mode: Mode = 'shell';
    let handle: WorkshopHandle | null = null;
    let openId: StationId | null = null;
    let loadToken = 0;
    let slowTimer = 0;
    let lastTrigger: HTMLElement | null = null;
    const isWide = () => window.matchMedia('(min-width: 900px)').matches;

    exploreBtn.hidden = false;
    settingsBtn.hidden = false;
    root.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((b) => { b.hidden = false; });

    function setMode(next: Mode) {
      mode = next;
      root.dataset.mode = next;
      const immersive = next !== 'shell';
      stage.hidden = !immersive;
      hero.inert = immersive;
      document.documentElement.classList.toggle('ws-locked', immersive);
      loading.hidden = next !== 'loading';
      if (!immersive) {
        stationBtns.forEach((b) => { b.style.transform = ''; b.style.visibility = ''; });
        hint.hidden = true;
      }
    }

    function say(html: string) { statusEl.innerHTML = html; }
    // Labels become visible on the next rendered frame; focus after that.
    function focusSoon(el?: HTMLElement | null) {
      requestAnimationFrame(() => requestAnimationFrame(() => el?.focus({ preventScroll: true })));
    }

    // ─── Panels ───
    function showPanel(id: StationId | null, opts: { focus?: boolean } = {}) {
      openId = id;
      panels.forEach((p) => p.classList.toggle('is-open', p.dataset.panel === id));
      stationBtns.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.station === id)));
      root.classList.toggle('has-panel', !!id);
      if (handle) handle.focus(id, id && isWide() ? 440 : 0);
      if (id && opts.focus !== false) {
        const panel = panels.find((p) => p.dataset.panel === id);
        panel?.focus({ preventScroll: mode !== 'shell' });
        if (mode === 'shell') panel?.scrollIntoView({ block: 'nearest', behavior: reducedMotion() ? 'auto' : 'smooth' });
      }
      overviewBtn.hidden = !id || mode !== 'workshop';
    }

    // ─── URL is the source of truth: Back, Forward, reload and deep links work ───
    function readURL() {
      const q = new URLSearchParams(location.search);
      const s = q.get('station') as StationId | null;
      return { workshop: q.get('mode') === 'workshop', station: s && IDS.includes(s) ? s : null };
    }
    function writeURL(next: { workshop: boolean; station: StationId | null }, push: boolean) {
      const q = new URLSearchParams();
      if (next.workshop) q.set('mode', 'workshop');
      if (next.station) q.set('station', next.station);
      const url = location.pathname + (q.toString() ? `?${q}` : '');
      if (push) history.pushState({ ws: true }, '', url);
      else history.replaceState({ ws: !!history.state?.ws }, '', url);
    }
    function sync(fromNav: boolean) {
      const want = readURL();
      if (want.workshop && mode === 'shell') enterWorkshop(true);
      if (!want.workshop && mode !== 'shell') exitWorkshop();
      if (want.station !== openId) showPanel(want.station, { focus: !fromNav || mode === 'shell' });
    }
    window.addEventListener('popstate', () => sync(true));

    // ─── Workshop lifecycle ───
    async function enterWorkshop(skipIntro: boolean) {
      if (!hasWebGL2()) {
        writeURL({ workshop: false, station: openId }, false);
        say('This browser can’t run the 3D workshop, so you’re seeing the plain version. Everything is below. <button type="button" class="ws-link-btn" data-retry>Try again</button>');
        return;
      }
      const token = ++loadToken;
      say('');
      setMode('loading');
      slow.hidden = true;
      window.clearTimeout(slowTimer);
      slowTimer = window.setTimeout(() => { if (token === loadToken && mode === 'loading') slow.hidden = false; }, 10000);
      loading.querySelector<HTMLElement>('[data-cancel]')?.focus();
      try {
        const mod = await import('../scripts/workshop-scene');
        if (token !== loadToken) return; // cancelled or navigated away
        const q = resolveQuality();
        const rm = reducedMotion();
        // A disposed renderer forces its context loss, so every mount gets a fresh canvas.
        const fresh = canvas.cloneNode(false) as HTMLCanvasElement;
        canvas.replaceWith(fresh);
        canvas = fresh;
        handle = mod.mountWorkshop({
          canvas,
          quality: q.quality,
          autoQuality: q.auto,
          reducedMotion: rm,
          skipIntro: skipIntro || !!openId,
          onSelect: (id) => openStation(id),
          onFrame: placeLabels,
          onIntroPhase: (phase) => {
            if (phase === 'controls') hint.hidden = false;
            if (phase === 'done') { skipBtn.hidden = true; replayBtn.hidden = rm; }
          },
          onContextLost: () => {
            teardown();
            setMode('shell');
            writeURL({ workshop: false, station: openId }, false);
            say('The 3D view stopped after a graphics reset, so you’re back on the plain version. <button type="button" class="ws-link-btn" data-retry-lite>Retry in Lite mode</button>');
          },
        });
        window.clearTimeout(slowTimer);
        setMode('workshop');
        skipBtn.hidden = skipIntro || !!openId || rm;
        replayBtn.hidden = !(skipIntro || !!openId) || rm;
        if (openId) handle.focus(openId, isWide() ? 440 : 0);
        overviewBtn.hidden = !openId;
        focusSoon(openId ? panels.find((p) => p.dataset.panel === openId) : skipBtn.hidden ? stationBtns[0] : skipBtn);
      } catch (err) {
        console.error('[workshop]', err);
        teardown();
        setMode('shell');
        writeURL({ workshop: false, station: openId }, false);
        say('The workshop couldn’t load. The full portfolio is right here. <button type="button" class="ws-link-btn" data-retry>Try again</button>');
      }
    }
    function teardown() {
      loadToken++;
      window.clearTimeout(slowTimer);
      handle?.dispose();
      handle = null;
    }
    function exitWorkshop() {
      teardown();
      setMode('shell');
      exploreBtn.focus({ preventScroll: true });
    }

    function placeLabels(labels: LabelPositions, controlsVisible: boolean) {
      // Keep every label on screen (pinned to the edge if its station is out of view),
      // so pointer and keyboard users can always reach all four stations.
      const vw = window.innerWidth, vh = window.innerHeight;
      const right = openId && isWide() ? vw - 456 : vw - 16;
      const placed: { b: HTMLButtonElement; x: number; y: number; w: number; h: number; show: boolean }[] = [];
      for (const b of stationBtns) {
        const l = labels[b.dataset.station as StationId];
        if (!l) continue;
        const w = b.offsetWidth, h = b.offsetHeight;
        placed.push({
          b, w, h, show: controlsVisible && l.visible,
          x: Math.min(Math.max(l.x, 16 + w / 2), right - w / 2),
          y: Math.min(Math.max(l.y, 132 + h), vh - 64),
        });
      }
      // Nudge labels apart when two land on the same spot (usually when pinned to an edge).
      placed.sort((a, b) => a.y - b.y);
      for (let i = 1; i < placed.length; i++) {
        for (let j = 0; j < i; j++) {
          const a = placed[j], c = placed[i];
          if (Math.abs(a.x - c.x) < (a.w + c.w) / 2 + 6 && Math.abs(a.y - c.y) < a.h + 6) c.y = a.y + a.h + 8;
        }
      }
      for (const p of placed) {
        p.b.style.transform = `translate(${p.x.toFixed(1)}px, ${p.y.toFixed(1)}px) translate(-50%, -100%)`;
        p.b.style.visibility = p.show ? 'visible' : 'hidden';
      }
    }

    function openStation(id: StationId, trigger?: HTMLElement) {
      lastTrigger = trigger ?? stationBtns.find((b) => b.dataset.station === id) ?? null;
      const cur = readURL();
      if (cur.station === id) { showPanel(id); return; }
      // Replace when switching between stations so Back returns to the overview, not a chain of panels.
      writeURL({ workshop: mode !== 'shell', station: id }, !cur.station);
      showPanel(id);
    }
    function closeStation() {
      const returnTo = lastTrigger;
      if (history.state?.ws && readURL().station) history.back();
      else { writeURL({ workshop: mode !== 'shell', station: null }, false); showPanel(null); }
      (returnTo ?? stationBtns[0])?.focus({ preventScroll: true });
    }

    // ─── Wiring ───
    exploreBtn.addEventListener('click', () => {
      writeURL({ workshop: true, station: openId }, true);
      enterWorkshop(false);
    });
    root.querySelector('[data-exit]')!.addEventListener('click', () => {
      showPanel(null);
      exitWorkshop();
      writeURL({ workshop: false, station: null }, false);
    });
    root.querySelector('[data-cancel]')!.addEventListener('click', () => {
      writeURL({ workshop: false, station: openId }, false);
      exitWorkshop();
    });
    root.querySelector('[data-try-lite]')!.addEventListener('click', () => {
      prefs.quality = 'lite';
      store.set('ws-quality', 'lite');
      root.querySelectorAll<HTMLInputElement>('input[name="ws-quality"]').forEach((i) => { i.checked = i.value === 'lite'; });
      teardown();
      enterWorkshop(true);
    });
    skipBtn.addEventListener('click', () => {
      handle?.skipIntro();
      skipBtn.hidden = true;
      replayBtn.hidden = reducedMotion();
      focusSoon(stationBtns[0]);
    });
    replayBtn.addEventListener('click', () => {
      if (readURL().station) closeStation();
      handle?.replayIntro();
      replayBtn.hidden = true;
      skipBtn.hidden = false;
      hint.hidden = true;
      skipBtn.focus({ preventScroll: true });
    });
    overviewBtn.addEventListener('click', () => closeStation());
    stationBtns.forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.station as StationId;
      if (openId === id && mode === 'shell') { closeStation(); return; }
      openStation(id, b);
    }));
    root.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => closeStation()));
    statusEl.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('[data-retry]')) { writeURL({ workshop: true, station: openId }, true); enterWorkshop(false); }
      if (t.matches('[data-retry-lite]')) {
        prefs.quality = 'lite';
        store.set('ws-quality', 'lite');
        writeURL({ workshop: true, station: openId }, true);
        enterWorkshop(true);
      }
    });

    // Settings: changes apply immediately; the scene remounts without replaying the intro.
    settingsBtn.addEventListener('click', () => {
      const open = settings.hidden;
      settings.hidden = !open;
      settingsBtn.setAttribute('aria-expanded', String(open));
      if (open) settings.querySelector<HTMLInputElement>('input:checked')?.focus();
    });
    settings.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name === 'ws-quality') { prefs.quality = input.value; store.set('ws-quality', input.value); }
      if (input.name === 'ws-motion') { prefs.motion = input.value; store.set('ws-motion', input.value); }
      root.classList.toggle('ws-reduce', reducedMotion());
      if (mode === 'workshop') { teardown(); enterWorkshop(true); }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!settings.hidden) { settings.hidden = true; settingsBtn.setAttribute('aria-expanded', 'false'); settingsBtn.focus(); return; }
      if (openId) { e.preventDefault(); closeStation(); }
    });
    document.addEventListener('click', (e) => {
      if (!settings.hidden && !(e.target as Element).closest('.ws-settings, .ws-settings-btn')) {
        settings.hidden = true;
        settingsBtn.setAttribute('aria-expanded', 'false');
      }
    });
    window.addEventListener('pagehide', () => teardown());

    // Initial state from the URL (deep link opens content immediately, no intro).
    history.replaceState({ ws: false }, '', location.href);
    sync(false);
  </script>
</BaseLayout>
