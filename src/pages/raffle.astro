---
<BaseLayout
  title="Claude In The Wild — raffle | Amit Arora"
  description="Unofficial Claude meetup in Frisco, hosted by ClawPlex. Friday, May 15 · 2:00 – 4:00 PM CDT at 25N Coworking. Scan the QR or tap to enter the raffle."
  canonical="https://amit.so/raffle"
  jsonLd={jsonLd}
  showFloatingCta={false}
>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <div class="built-root raffle-root">
    <nav class="built-topnav raffle-nav">
      <a href="/built" class="brand">Claude in the Wild <span aria-hidden="true">·</span> meetup</a>
      <a href="#raffle" class="raffle-btn raffle-btn--hero">🎟 Enter the raffle</a>
      <div class="raffle-right">
        <a href="/screensaver" class="ss-toggle" aria-label="Enable screensaver" title="Enable screensaver">
          <span class="ss-toggle-track" aria-hidden="true"><span class="ss-toggle-thumb"></span></span>
          <span class="ss-toggle-label">Screensaver</span>
        </a>
        <a href="/built" class="raffle-back">← Back to /built</a>
      </div>
    </nav>

    <main class="built-main raffle-main">
      <header class="hero">
        <p class="hero-eyebrow">Frisco · Plano · Claude Meetup · May 15, 2026</p>
        <a
          class="sponsor"
          href="https://25ncoworking.com/locations/frisco-tx/meeting-rooms"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sponsored by 25N Coworking in Frisco — view meeting rooms"
        >
          <span class="sponsor-label">Sponsored by</span>
          <img class="sponsor-logo" src="/built/25n-logo.webp" alt="25N Coworking" width="180" height="48" loading="eager" />
          <span class="sponsor-loc"><span aria-hidden="true">·</span> Frisco, TX</span>
        </a>
        <h1 class="hero-title">Claude in the wild. <em>Win some swag.</em></h1>
        <p class="hero-intro">
          Unofficial meetup, hosted by ClawPlex. Three talks, one room, a couple of hours.
          Share the meetup on LinkedIn, scan the QR, drop your name into the raffle.
        </p>

        <ul class="event-meta" role="list">
          <li>
            <span class="event-meta-eyebrow">Date</span>
            <span class="event-meta-value">Friday, May 15</span>
          </li>
          <li>
            <span class="event-meta-eyebrow">Time</span>
            <span class="event-meta-value">2:00 – 4:00 PM CDT</span>
          </li>
          <li>
            <span class="event-meta-eyebrow">Venue</span>
            <span class="event-meta-value">25N Coworking Frisco</span>
            <span class="event-meta-sub">9355 John W. Elliott Dr #25, Frisco, TX</span>
          </li>
        </ul>

        <div class="hero-actions">
          <a href="#raffle" class="hero-cta hero-cta--primary">Enter the raffle <span aria-hidden="true">↓</span></a>
          <a href="#share" class="hero-cta hero-cta--ghost">Share on LinkedIn</a>
        </div>
      </header>

      <section id="scan" class="section section--scan section--right" aria-labelledby="scan-title">
        <div class="section-num" aria-hidden="true">01</div>
        <div class="section-grid">
          <div class="section-copy">
            <p class="section-eyebrow">Fastest path · scan to enter</p>
            <h2 id="scan-title" class="section-title">Point your camera. <em>You're in.</em></h2>
            <p class="section-p">
              Open the camera, frame the code, tap the link, drop your name. Sixty seconds, end to end.
            </p>
            <p class="section-p">
              Prefer to use the keyboard? Scroll down — the same form sits at section 04.
            </p>
            <ul class="section-chips" aria-label="Steps" role="list">
              <li>Scan QR</li>
              <li>LinkedIn share</li>
              <li>Win swag</li>
            </ul>
          </div>
          <aside class="section-visual" aria-hidden="true">
            <div class="mock qr-mock">
              <p class="mock-eyebrow">Scan to enter</p>
              <img src="/raffle/raffle-qr.png" alt="QR code linking to the raffle entry form" width="320" height="320" loading="eager" />
              <p class="qr-mock-foot">amit.so/raffle</p>
            </div>
          </aside>
        </div>
      </section>

      <section id="share" class="section section--left" aria-labelledby="share-title">
        <div class="section-num" aria-hidden="true">02</div>
        <div class="section-grid">
          <div class="section-copy">
            <p class="section-eyebrow">Step one · share</p>
            <h2 id="share-title" class="section-title">Share the post on <em>LinkedIn.</em></h2>
            <p class="section-p">
              Copy the post on the right, paste it into a new LinkedIn post, and publish. Take a screenshot of the published post — you'll attach it in step two.
            </p>
            <div class="hero-actions">
              <button type="button" class="hero-cta hero-cta--primary" id="copy-btn" data-copy-target="li-post">Copy post</button>
              <a href="https://www.linkedin.com/feed/?shareActive=true" target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta--ghost">Open LinkedIn ↗</a>
            </div>
          </div>
          <aside class="section-visual" aria-hidden="true">
            <div class="mock post-mock">
              <div class="post-mock-head">
                <span class="post-mock-dot" aria-hidden="true"></span>
                <span>linkedin · new post</span>
              </div>
              <pre class="post-mock-body" id="li-post">{linkedInPost}</pre>
              <div class="post-mock-foot">
                <span>Tag · #FriscoTech #Coworking #Networking</span>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section id="raffle" class="section" aria-labelledby="raffle-title">
        <div class="section-num" aria-hidden="true">03</div>
        <div class="section-grid section-grid--solo">
          <div class="section-copy section-copy--wide">
            <p class="section-eyebrow">Step two · enter</p>
            <h2 id="raffle-title" class="section-title">Drop your name <em>in the hat.</em></h2>
            <p class="section-p">
              Click below to open the entry form in a popup. Paste your LinkedIn screenshot, hit submit, and you're entered. We draw at the event.
            </p>
            <div class="qs-launch">
              <a
                id="qs-embed-6a064bb27764fa860b996787-btn"
                href="https://form.questionscout.com/6a0377faa812b1dffda0db08"
                target="_blank"
                rel="noopener noreferrer"
              >Enter the raffle</a>
              <p class="qs-hint">Popup. About 60 seconds. Bring your screenshot.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="hosts" class="section" aria-labelledby="hosts-title">
        <div class="section-num" aria-hidden="true">04</div>
        <div class="combo-grid">
          <div class="combo-hosts">
            <p class="section-eyebrow">Hosted by ClawPlex</p>
            <h2 id="hosts-title" class="section-title">Your <em>operators</em> for the afternoon.</h2>
            <ul class="hosts-2x2" role="list">
              {hosts.map((h) => (
                <li>
                  <a class="host-card" href={h.li} target="_blank" rel="noopener noreferrer">
                    <img src={h.img} alt={h.name} loading="lazy" width="120" height="120" />
                    <span class="host-name">{h.name}</span>
                    <span class="host-role">{h.role}</span>
                    <span class="host-link">LinkedIn ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="combo-sponsor">
            <p class="section-eyebrow">Sponsored by</p>
            <a href="https://25ncoworking.com/locations/frisco-tx/meeting-rooms" target="_blank" rel="noopener noreferrer" class="sponsor-card">
              <div class="sponsor-card-logo">
                <img src="/built/25n-logo.webp" alt="25N Coworking" width="240" height="70" />
              </div>
              <p class="sponsor-card-line">25N Coworking Frisco</p>
              <p class="sponsor-card-sub">9355 John W. Elliott Dr #25 · Frisco, TX</p>
              <p class="sponsor-card-blurb">
                The room, the wi-fi, the coffee, and the projector. Our reason this meetup has a roof and a screen.
              </p>
              <span class="sponsor-card-cta">Visit 25N Frisco ↗</span>
            </a>
          </div>
        </div>
      </section>

    </main>

    <footer class="built-footer">
      <span>&copy; 2026 Amit Arora · <a href="/">amit.so</a></span>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/built">/built</a>
      <span class="sep" aria-hidden="true">·</span>
      <span>Built with Claude · Presented by ClawPlex</span>
    </footer>

    <aside class="r-toast" id="r-toast" aria-live="polite" aria-label="Latest attendee activity">
      <span class="r-toast-dot" aria-hidden="true"></span>
      <div class="r-toast-body">
        <span class="r-toast-line" id="r-toast-line">…</span>
        <span class="r-toast-meta">live · attendees</span>
      </div>
    </aside>
  </div>

  <script is:inline id="qs-embed-6a064bb27764fa860b996787">(function(p){var s=window.document.createElement('script');s.src=p.a;s.setAttribute('data-form-id',p.b);s.setAttribute('data-url-params',p.c);s.setAttribute('data-runner-id',p.d);s.setAttribute('data-css',p.e);s.setAttribute('data-button',true);window.document.head.appendChild(s);})({"a":"https://form.questionscout.com/qs-form-script.min.js","b":"6a0377faa812b1dffda0db08","c":"[]","d":"qs-embed-6a064bb27764fa860b996787","e":""})</script>

  <script is:inline define:vars={{ ATTENDEES, VERBS }}>
    (function () {
      var line = document.getElementById('r-toast-line');
      var toast = document.getElementById('r-toast');
      if (line && toast && Array.isArray(ATTENDEES) && Array.isArray(VERBS)) {
        var lastName = '';
        var lastVerb = '';
        function pick(arr, prev) {
          if (arr.length < 2) return arr[0];
          var v = prev;
          while (v === prev) v = arr[Math.floor(Math.random() * arr.length)];
          return v;
        }
        function show() {
          lastName = pick(ATTENDEES, lastName);
          lastVerb = pick(VERBS, lastVerb);
          while (line.firstChild) line.removeChild(line.firstChild);
          var bold = document.createElement('strong');
          bold.textContent = lastName;
          line.appendChild(bold);
          line.appendChild(document.createTextNode(' ' + lastVerb + '… at the meetup'));
          toast.classList.remove('is-in');
          void toast.offsetWidth;
          toast.classList.add('is-in');
        }
        setTimeout(show, 900);
        setInterval(show, 4200);
      }

      var copyBtn = document.getElementById('copy-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var el = document.getElementById(copyBtn.getAttribute('data-copy-target'));
          if (!el) return;
          var t = el.innerText;
          var orig = copyBtn.innerText;
          var done = function () {
            copyBtn.innerText = 'Copied ✓';
            setTimeout(function () { copyBtn.innerText = orig; }, 1800);
          };
          function fallback(text, cb) {
            var ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); cb(); } catch (e) {}
            document.body.removeChild(ta);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(t).then(done, function () { fallback(t, done); });
          } else { fallback(t, done); }
        });
      }
    })();
  </script>

  <style is:global>
    /* ─── Raffle-specific styles on top of built.css ─── */
    .raffle-root .grain { display: none; }
    .raffle-nav { grid-template-columns: auto 1fr auto !important; }
    .raffle-back {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--ink-mute);
      text-decoration: none;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .raffle-back:hover { color: var(--accent); }
    .raffle-btn--hero {
      justify-self: end;
    }
    @media (max-width: 720px) {
      .raffle-nav { grid-template-columns: auto auto !important; }
      .raffle-back { display: none; }
    }

    .raffle-main .hero {
      padding-bottom: 3rem;
    }

    /* Hero event meta tiles */
    .event-meta {
      list-style: none; padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.85rem;
      margin: 0.5rem 0 2rem;
      max-width: 880px;
    }
    .event-meta li {
      padding: 1rem 1.1rem 1.15rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--card);
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      box-shadow: 0 1px 0 rgba(31, 31, 29, 0.03);
    }
    .event-meta-eyebrow {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .event-meta-value {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      letter-spacing: -0.005em;
    }
    .event-meta-sub {
      font-family: var(--sans);
      font-size: 0.82rem;
      color: var(--ink-mute);
      line-height: 1.45;
    }
    @media (max-width: 720px) {
      .event-meta { grid-template-columns: 1fr; }
    }

    /* Hero CTAs (also reused in section 03) */
    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.25rem; }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.5rem;
      border-radius: 999px;
      font-family: var(--mono);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      border: 1px solid transparent;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .hero-cta--primary {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
      box-shadow: 0 14px 28px -16px rgba(217, 119, 87, 0.6);
    }
    .hero-cta--primary:hover { transform: translateY(-1px); background: #c66948; border-color: #c66948; }
    .hero-cta--ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--ink-faint);
    }
    .hero-cta--ghost:hover { transform: translateY(-1px); border-color: var(--ink); }

    /* Solo section grid (single column) */
    .section-grid--solo { grid-template-columns: minmax(0, 1fr) !important; }
    .section-copy--wide { max-width: 820px; }

    /* QR mock (section 01) */
    .qr-mock {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
    }
    .qr-mock img {
      display: block;
      width: 100%;
      max-width: 320px;
      height: auto;
      border-radius: 12px;
      background: #fff;
      padding: 0.65rem;
      border: 1px solid var(--line);
    }
    .qr-mock-foot {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }

    /* LinkedIn post mock (section 03) */
    .post-mock { padding: 0; overflow: hidden; }
    .post-mock-head {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.7rem 1rem;
      background: var(--card-warm);
      border-bottom: 1px solid var(--line);
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .post-mock-dot {
      width: 7px; height: 7px;
      background: var(--accent);
      border-radius: 50%;
    }
    .post-mock-body {
      padding: 1.1rem 1.25rem;
      font-family: var(--sans);
      font-size: 0.96rem;
      line-height: 1.6;
      white-space: pre-wrap;
      color: var(--ink);
      margin: 0;
    }
    .post-mock-foot {
      padding: 0.65rem 1rem;
      border-top: 1px solid var(--line);
      background: var(--card-warm);
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--accent);
    }

    /* QS popup button (section 04) — match coral pill aesthetic */
    .qs-launch { display: flex; flex-direction: column; gap: 0.65rem; margin-top: 1.5rem; align-items: flex-start; }
    body #qs-embed-6a064bb27764fa860b996787-btn,
    body a#qs-embed-6a064bb27764fa860b996787-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.95rem 1.75rem;
      border-radius: 999px;
      background: var(--accent);
      color: var(--bg);
      font-family: var(--mono);
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      border: 1px solid var(--accent);
      box-shadow: 0 14px 28px -16px rgba(217, 119, 87, 0.6);
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    body #qs-embed-6a064bb27764fa860b996787-btn:hover {
      transform: translateY(-1px);
      background: #c66948;
      border-color: #c66948;
