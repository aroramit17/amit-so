---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/built.css';

const hosts = [
  { name: 'Amit Arora', img: '/raffle/host-amit.webp', li: 'https://www.linkedin.com/in/amit-arora17', role: 'Host · Frisco' },
  { name: 'Tyler Delano', img: '/raffle/host-tyler.webp', li: 'https://www.linkedin.com/in/tylerpdelano/', role: 'Host · ClawPlex' },
  { name: 'Anjal Parikh', img: '/raffle/host-anjal.webp', li: 'https://www.linkedin.com/in/anjal-parikh/', role: 'Host · Agency' },
  { name: 'Jonathon Hasling', img: '/raffle/host-jonny.webp', li: 'https://www.linkedin.com/in/jonathon-h-0266a2409/', role: 'Host · ClawPlex' },
];


const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Claude In The Wild Meetup',
  startDate: '2026-05-15T14:00:00-05:00',
  endDate: '2026-05-15T16:00:00-05:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: '25N Coworking Frisco',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '9355 John W. Elliott Dr #25',
      addressLocality: 'Frisco',
      addressRegion: 'TX',
      addressCountry: 'US',
    },
  },
  organizer: { '@type': 'Organization', name: 'ClawPlex' },
  sponsor: { '@type': 'Organization', name: '25N Coworking Frisco' },
});
---
<BaseLayout
  title="Claude in the Wild Meetup Archive | Amit Arora"
  description="Archive of Claude in the Wild, an unofficial Claude meetup in Frisco hosted by ClawPlex at 25N Coworking on May 15, 2026. The raffle is closed."
  canonical="https://amit.so/raffle"
  jsonLd={jsonLd}
  showFloatingCta={false}
>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <div class="built-root raffle-root">
    <nav class="built-topnav raffle-nav">
      <a href="/built" class="brand">Claude in the Wild <span aria-hidden="true">·</span> meetup</a>
      <div class="raffle-right">
        <a href="/screensaver" class="ss-toggle" aria-label="Enable screensaver" title="Enable screensaver">
          <span class="ss-toggle-track" aria-hidden="true"><span class="ss-toggle-thumb"></span></span>
          <span class="ss-toggle-label">Screensaver</span>
        </a>
        <a href="/built" class="raffle-back">← Back to /built</a>
      </div>
    </nav>

    <main class="built-main raffle-main">
      <header class="hero">
        <p class="hero-eyebrow">Event archive · Frisco · Claude Meetup · May 15, 2026</p>
        <a
          class="sponsor"
          href="https://25ncoworking.com/locations/frisco-tx/meeting-rooms"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sponsored by 25N Coworking in Frisco — view meeting rooms"
        >
          <span class="sponsor-label">Sponsored by</span>
          <img class="sponsor-logo" src="/built/25n-logo.webp" alt="25N Coworking" width="180" height="48" loading="eager" />
          <span class="sponsor-loc"><span aria-hidden="true">·</span> Frisco, TX</span>
        </a>
        <h1 class="hero-title">Claude in the wild. <em>The raffle is closed.</em></h1>
        <p class="hero-intro">
          An unofficial meetup hosted by ClawPlex on May 15, 2026. Three talks, one room, a couple of hours.
          The raffle ran during the event and is no longer taking entries. The talks are archived on <a href="/built#event-archive">/built</a>,
          and upcoming meetups are listed at <a href="https://clawplex.dev" target="_blank" rel="noopener noreferrer">clawplex.dev</a>.
        </p>

        <ul class="event-meta" role="list">
          <li>
            <span class="event-meta-eyebrow">Date</span>
            <span class="event-meta-value">Friday, May 15, 2026</span>
          </li>
          <li>
            <span class="event-meta-eyebrow">Time</span>
            <span class="event-meta-value">2:00 – 4:00 PM CDT</span>
          </li>
          <li>
            <span class="event-meta-eyebrow">Venue</span>
            <span class="event-meta-value">25N Coworking Frisco</span>
            <span class="event-meta-sub">9355 John W. Elliott Dr #25, Frisco, TX</span>
          </li>
        </ul>

        <div class="hero-actions">
          <a href="/built#event-archive" class="hero-cta hero-cta--primary">See the talks</a>
          <a href="https://clawplex.dev" target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta--ghost">Next ClawPlex meetup ↗</a>
        </div>
      </header>

      <section id="sponsor" class="section" aria-labelledby="sponsor-title">
        <div class="section-num" aria-hidden="true">01</div>
        <header class="combo-header">
          <p class="section-eyebrow">Sponsored by</p>
          <h2 id="sponsor-title" class="section-title">Our <em>home</em> for the meetup.</h2>
        </header>

        <a href="https://25ncoworking.com/locations/frisco-tx/meeting-rooms" target="_blank" rel="noopener noreferrer" class="sponsor-wide">
          <div class="sponsor-wide-logo">
            <img src="/built/25n-logo.webp" alt="25N Coworking" width="280" height="80" />
          </div>
          <div class="sponsor-wide-body">
            <p class="sponsor-card-line">25N Coworking Frisco</p>
            <p class="sponsor-card-sub">9355 John W. Elliott Dr #25 <span aria-hidden="true">·</span> Frisco, TX</p>
            <p class="sponsor-card-blurb">
              The room, the wi-fi, the coffee, and the projector. Our reason this meetup has a roof and a screen.
            </p>
            <ul class="sponsor-feats" role="list">
              <li>Meeting rooms</li>
              <li>Hot desks</li>
              <li>Private offices</li>
              <li>Day passes</li>
            </ul>
            <span class="sponsor-card-cta">Visit 25N Frisco ↗</span>
          </div>
        </a>
      </section>

      <section id="hosts" class="section" aria-labelledby="hosts-title">
        <div class="section-num" aria-hidden="true">02</div>
        <header class="combo-header combo-header--centered">
          <p class="section-eyebrow">Hosted by</p>
          <h2 id="hosts-title" class="section-title">We are <em>ClawPlex.</em></h2>
          <p class="combo-sub combo-sub--centered">A small operator collective shipping with Claude.</p>
        </header>
        <ul class="hosts-row" role="list">
          {hosts.map((h) => (
            <li>
              <a class="host-card" href={h.li} target="_blank" rel="noopener noreferrer">
                <img src={h.img} alt={h.name} loading="lazy" width="120" height="120" />
                <span class="host-name">{h.name}</span>
                <span class="host-link">LinkedIn ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

    </main>

    <footer class="built-footer">
      <span>&copy; 2026 Amit Arora · <a href="/">amit.so</a></span>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/built">/built</a>
      <span class="sep" aria-hidden="true">·</span>
      <span>Built with Claude · Presented by ClawPlex</span>
    </footer>

  </div>



  <style is:global>
    /* ─── Raffle-specific styles on top of built.css ─── */
    .raffle-root .grain { display: none; }
    .raffle-nav { grid-template-columns: auto 1fr auto !important; }
    .raffle-back {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--ink-mute);
      text-decoration: none;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .raffle-back:hover { color: var(--accent); }
    .raffle-right { grid-column: 3; justify-self: end; display: flex; align-items: center; gap: 1.25rem; }
    .raffle-root .hero-intro a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 720px) {
      .raffle-nav { grid-template-columns: auto auto !important; }
      .raffle-right { grid-column: 2; }
      .raffle-back { display: none; }
    }

    .raffle-main .hero {
      padding-bottom: 3rem;
    }

    /* Hero event meta tiles */
    .event-meta {
      list-style: none; padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.85rem;
      margin: 0.5rem 0 2rem;
      max-width: 880px;
    }
    .event-meta li {
      padding: 1rem 1.1rem 1.15rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--card);
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      box-shadow: 0 1px 0 rgba(31, 31, 29, 0.03);
    }
    .event-meta-eyebrow {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .event-meta-value {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      letter-spacing: -0.005em;
    }
    .event-meta-sub {
      font-family: var(--sans);
      font-size: 0.82rem;
      color: var(--ink-mute);
      line-height: 1.45;
    }
    @media (max-width: 720px) {
      .event-meta { grid-template-columns: 1fr; }
    }

    /* Hero CTAs (also reused in section 03) */
    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.25rem; }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.5rem;
      border-radius: 999px;
      font-family: var(--mono);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      border: 1px solid transparent;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .hero-cta--primary {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
      box-shadow: 0 14px 28px -16px rgba(49, 94, 251, 0.45);
    }
    .hero-cta--primary:hover { transform: translateY(-1px); background: #2146d7; border-color: #2146d7; }
    .hero-cta--ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--ink-faint);
    }
    .hero-cta--ghost:hover { transform: translateY(-1px); border-color: var(--ink); }

    /* Solo section grid (single column) */
    .section-grid--solo { grid-template-columns: minmax(0, 1fr) !important; }
    .section-copy--wide { max-width: 820px; }

    /* QR mock (section 01) */
    .qr-mock {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
    }
    .qr-mock img {
      display: block;
      width: 100%;
      max-width: 320px;
      height: auto;
      border-radius: 12px;
      background: #fff;
      padding: 0.65rem;
      border: 1px solid var(--line);
    }
    .qr-mock-foot {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }

    /* LinkedIn post mock (section 03) */
    .post-mock { padding: 0; overflow: hidden; }
    .post-mock-head {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.7rem 1rem;
      background: var(--card-warm);
      border-bottom: 1px solid var(--line);
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .post-mock-dot {
      width: 7px; height: 7px;
      background: var(--accent);
      border-radius: 50%;
    }
    .post-mock-body {
      padding: 1.1rem 1.25rem;
      font-family: var(--sans);
      font-size: 0.96rem;
      line-height: 1.6;
      white-space: pre-wrap;
      color: var(--ink);
      margin: 0;
    }
    .post-mock-foot {
      padding: 0.65rem 1rem;
      border-top: 1px solid var(--line);
      background: var(--card-warm);
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--accent);
    }

    /* QS popup button (section 04) — match coral pill aesthetic */
    .qs-launch { display: flex; flex-direction: column; gap: 0.65rem; margin-top: 1.5rem; align-items: flex-start; }
    body #qs-embed-6a064bb27764fa860b996787-btn,
    body a#qs-embed-6a064bb27764fa860b996787-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.95rem 1.75rem;
      border-radius: 999px;
      background: var(--accent);
      color: var(--bg);
      font-family: var(--mono);
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      border: 1px solid var(--accent);
      box-shadow: 0 14px 28px -16px rgba(49, 94, 251, 0.45);
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    body #qs-embed-6a064bb27764fa860b996787-btn:hover {
      transform: translateY(-1px);
      background: #2146d7;
      border-color: #2146d7;
      box-shadow: 0 18px 32px -16px rgba(49, 94, 251, 0.55);
    }
    body #qs-embed-6a064bb27764fa860b996787-btn:active { transform: translateY(0); }
    .qs-hint {
      font-family: var(--mono);
      font-size: 0.76rem;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
    }

    /* ─── Sponsor (section 04) + Hosts (section 05) ─── */
    .combo-header {
      max-width: 880px;
      margin-bottom: 2.5rem;
    }
    .combo-header--centered {
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }
    .combo-sub--centered { display: block; margin-top: 0.85rem; }
    .combo-header .section-eyebrow span,
    .sponsor-card-sub span { color: var(--ink-faint); padding: 0 0.4em; }

    /* Wide sponsor card (section 04) */
    .sponsor-wide {
      display: grid;
      grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
      padding: 1.75rem 2rem 1.85rem;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--card);
      text-decoration: none;
      color: var(--ink);
      box-shadow: 0 1px 0 rgba(20, 35, 59, 0.04), 0 28px 60px -30px rgba(49, 94, 251, 0.26);
      transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }
    .sponsor-wide:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 1px 0 rgba(20, 35, 59, 0.04), 0 32px 64px -28px rgba(49, 94, 251, 0.42);
    }
    .sponsor-wide-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1.5rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--card-warm);
    }
    .sponsor-wide-logo img { display: block; height: 56px; width: auto; }
    .sponsor-wide-body {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .sponsor-wide-body .sponsor-card-blurb { margin-top: 0.2rem; }
    .sponsor-wide-body .sponsor-feats { margin-top: 0.5rem; }
    .sponsor-wide-body .sponsor-card-cta { margin-top: 0.4rem; padding-top: 0; border-top: 0; }

    @media (max-width: 720px) {
      .sponsor-wide { grid-template-columns: 1fr; gap: 1.25rem; padding: 1.4rem 1.4rem 1.5rem; }
      .sponsor-wide-logo { padding: 1rem 1.25rem; }
      .sponsor-wide-logo img { height: 40px; }
    }

    /* Hosts row (section 05) — 4 across on desktop */
    .hosts-row {
      list-style: none; padding: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }
    .hosts-row li { display: flex; }
    .hosts-row .host-card { flex: 1; }
    @media (max-width: 880px) {
      .hosts-row { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .hosts-row { grid-template-columns: 1fr; }
    }
    .combo-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2.5rem;
      align-items: stretch;
    }
    .combo-hosts {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .combo-sub {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .hosts-2x2 {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
      padding: 0;
      flex: 1;
    }
    .hosts-2x2 li { display: flex; }
    .hosts-2x2 .host-card { flex: 1; }

    /* Tall sponsor card — fills the column height to match the 2x2 grid */
    .sponsor-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.6rem 1.75rem 1.7rem;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--card);
      text-decoration: none;
      color: var(--ink);
      box-shadow: 0 1px 0 rgba(20, 35, 59, 0.04), 0 28px 56px -30px rgba(49, 94, 251, 0.26);
      transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
      height: 100%;
    }
    .sponsor-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 1px 0 rgba(20, 35, 59, 0.04), 0 32px 60px -28px rgba(49, 94, 251, 0.42);
    }
    .sponsor-card .combo-sub { margin-bottom: 0.2rem; }
    .sponsor-card-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 1.25rem;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card-warm);
    }
    .sponsor-card-logo img { display: block; height: 48px; width: auto; }
    .sponsor-card-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 0.25rem 0;
    }
    .sponsor-card-line {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.005em;
      color: var(--ink);
    }
    .sponsor-card-sub {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .sponsor-card-blurb {
      font-family: var(--sans);
      font-size: 0.94rem;
      line-height: 1.65;
      color: var(--ink);
      margin-top: 0.25rem;
    }
    .sponsor-feats {
      list-style: none; padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.4rem 0.6rem;
      margin-top: auto;
      padding-top: 0.5rem;
    }
    .sponsor-feats li {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
      padding: 0.35rem 0.55rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--card-warm);
      text-align: center;
    }
    .sponsor-card-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 0.04em;
      padding-top: 0.4rem;
      border-top: 1px solid var(--line);
    }
    @media (max-width: 880px) {
      .combo-grid { grid-template-columns: 1fr; gap: 2rem; align-items: start; }
      .sponsor-card-logo img { height: 36px; }
    }
    @media (max-width: 480px) {
      .hosts-2x2 { grid-template-columns: 1fr; }
      .sponsor-feats { grid-template-columns: 1fr; }
    }
    .hosts-grid {
      list-style: none; padding: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }
    .host-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
      padding: 1.25rem 1rem 1.35rem;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--card);
      text-decoration: none;
      color: var(--ink);
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .host-card:hover {
      border-color: var(--accent-mid);
      transform: translateY(-2px);
      box-shadow: 0 1px 0 rgba(20, 35, 59, 0.04), 0 24px 50px -32px rgba(49, 94, 251, 0.28);
    }
    .host-card img {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--line);
      margin-bottom: 0.35rem;
    }
    .host-name {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1rem;
      color: var(--ink);
    }
    .host-role {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .host-link {
      font-family: var(--mono);
      font-size: 0.74rem;
      color: var(--accent);
      margin-top: 0.25rem;
    }
    @media (max-width: 880px) {
      .hosts-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .hosts-grid { grid-template-columns: 1fr; }
