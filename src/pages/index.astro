---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/Sections.jsx';
import '../styles/home.css';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Amit Arora",
  "url": "https://amit.so",
  "image": "https://amit.so/amit-headshot.png",
  "jobTitle": "Fractional GTM Engineer and Revenue Operations Leader",
  "description": "Fractional GTM engineer and Revenue Operations leader building trusted CRM architecture, lifecycle automation, pipeline, forecasting, and AI-powered GTM systems.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Aubrey",
    "addressRegion": "TX",
    "addressCountry": "US"
  },
  "sameAs": [
    "https://linkedin.com/in/amit-arora17",
    "https://youtube.com/@ai-withamit",
    "https://medium.com/gptcommands",
    "https://github.com/aroramit17"
  ],
  "knowsAbout": [
    "Revenue Operations",
    "Go-to-Market Strategy",
    "Salesforce Architecture",
    "Claude Code",
    "AI Workflow Automation",
    "HubSpot",
    "Clay",
    "n8n"
  ]
});
---
<BaseLayout
  title="Amit Arora — GTM Engineer, RevOps & CRM Architecture"
  description="Amit Arora builds the systems behind trusted pipeline: CRM architecture, lifecycle automation, lead routing, forecasting, and AI-powered GTM operations."
  canonical="https://amit.so/"
  jsonLd={jsonLd}
  showFloatingCta={false}
>
  <App client:load />
</BaseLayout>
