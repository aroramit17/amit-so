---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/home.css';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Amit Arora",
  "url": "https://amit.so",
  "image": "https://amit.so/amit-headshot.png",
  "jobTitle": "GTM Engineer and Revenue Operations Leader",
  "worksFor": { "@type": "Organization", "name": "Invoca" },
  "description": "GTM engineer and Revenue Operations leader building AI GTM systems at Invoca, with 10+ years in CRM architecture, forecasting, and revenue operations.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Aubrey",
    "addressRegion": "TX",
    "addressCountry": "US"
  },
  "sameAs": [
    "https://linkedin.com/in/amit-arora17",
    "https://youtube.com/@ai-withamit",
    "https://medium.com/gptcommands",
    "https://github.com/aroramit17"
  ],
  "knowsAbout": [
    "Revenue Operations",
    "Go-to-Market Strategy",
    "Salesforce Architecture",
    "Claude Code",
    "AI Workflow Automation",
    "HubSpot",
    "Clay",
    "n8n"
  ]
});
---
<BaseLayout
  title="GTM Engineer, RevOps & CRM Architecture | Amit Arora"
  description="Amit Arora builds the systems behind trusted pipeline: CRM architecture, lifecycle automation, lead routing, forecasting, and AI-powered GTM operations."
  canonical="https://amit.so/"
  jsonLd={jsonLd}
  showFloatingCta={false}
>
  <SiteNav />
  <HomeContent />
</BaseLayout>
