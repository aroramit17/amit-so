---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/intensive.css';

/**
 * Booking and payment both happen in the Cal.com popup — Cal's Stripe app
 * collects the $297 at booking, so there is no application step and no form
 * on this page. Anyone who wants a read before paying is pointed at email.
 *
 * The Supabase table this page used to write to (`amit-so` project,
 * `public.intensive_applications`) is intentionally left in place but is no
 * longer referenced from anywhere. Drop it if the form never comes back.
 */
const PRICE = 297;

// Cal.com element-click embed. Any element carrying these attributes opens the
// booking popup; the script at the bottom of the page registers the namespace.
const CAL_LINK = 'amit-arora/website-build-intensive';
const CAL_NAMESPACE = 'website-build-intensive';
const calTrigger = {
  'data-cal-link': CAL_LINK,
  'data-cal-namespace': CAL_NAMESPACE,
  'data-cal-config': '{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}',
};

const outcomes = [
  { title: 'Plan a new website', body: 'Start from a blank page and leave with structure, copy direction, and a working first build.' },
  { title: 'Redesign an existing page', body: 'Take a page that is not landing and rework the layout, hierarchy, and message.' },
  { title: 'Improve a sales or course page', body: 'Sharpen the offer, the proof, and the path to the button.' },
  { title: 'Fix mobile layout problems', body: 'Find what breaks on a phone and fix it while you watch.' },
  { title: 'Create a webinar or registration page', body: 'Build the page, the form, and the follow-through in one sitting.' },
  { title: 'Build a calculator, quiz, planner, or small web app', body: 'Turn an idea into a working interactive tool on your site.' },
  { title: 'Create the prompts to continue independently', body: 'Leave with the exact prompts that keep the work moving without me.' },
  { title: 'Develop a publishing and implementation plan', body: 'Know what ships, in what order, and how it goes live.' },
];

const included = [
  { title: 'Pre-session project questionnaire', body: 'I read your project before we start so the session opens at full speed.' },
  { title: 'Private 90-minute working session', body: 'One-to-one. Just you, me, and the project.' },
  { title: 'Live collaboration on your actual project', body: 'We work on your real site, not a demo or a slide deck.' },
  { title: 'Personalized website recommendations', body: 'Specific calls on structure, copy, and what to build next.' },
  { title: 'Custom master prompt', body: 'A prompt built around your project so you can keep going in ChatGPT and Codex.' },
  { title: 'Recording of the session', body: 'Rewatch every decision and every step.' },
  { title: 'Seven days of follow-up questions', body: 'You get stuck after the call, you still have me.' },
];

const steps = [
  { n: '01', title: 'Pick your time', body: 'Book the session and pay the $297 in the same step.' },
  { n: '02', title: 'Tell me about your project', body: 'You get a short questionnaire so I can review your site and your goal before we meet.' },
  { n: '03', title: 'We build together', body: 'Ninety minutes on your actual project, pointed at one priority outcome.' },
  { n: '04', title: 'You keep going', body: 'Leave with the recording, a custom master prompt, and seven days of follow-up questions.' },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "1:1 AI Website Build Intensive",
      "serviceType": "Website build working session",
      "url": "https://amit.so/1-1-with-amit",
      "description": "A private 90-minute working session with Amit Arora to plan, build, redesign, or improve your website using ChatGPT and Codex. Collaborative, not done-for-you.",
      "provider": {
        "@type": "Person",
        "name": "Amit Arora",
        "url": "https://amit.so",
        "sameAs": [
          "https://linkedin.com/in/amit-arora17",
          "https://youtube.com/@ai-withamit"
        ]
      },
      "areaServed": "Worldwide",
      "offers": {
        "@type": "Offer",
        "price": String(PRICE),
        "priceCurrency": "USD",
        "availability": "https://schema.org/LimitedAvailability",
        "url": "https://amit.so/1-1-with-amit"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is this a done-for-you website build?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. This is a collaborative website-building intensive. We focus on one clearly defined priority during the session. It is not a done-for-you agreement to design and deliver an entire website."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book a session?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pick a time in the booking popup and pay the $297 in the same step. You then get a short questionnaire so Amit can review your website and your goal before the session. If you would rather get a read on whether it is a fit before you pay, email me@amit.so first."
          }
        }
      ]
    }
  ]
});
---
<BaseLayout
  title="1:1 AI Website Build Intensive | Amit Arora"
  description="A private 90-minute working session with Amit Arora. Plan, build, redesign, or improve your website live using ChatGPT and Codex. $297, limited availability — book your time directly."
  canonical="https://amit.so/1-1-with-amit"
  jsonLd={jsonLd}
  showFloatingCta={false}
>
  <div class="intensive">
    <nav class="ix-nav">
      <a href="/" class="ix-brand">amit.so</a>
      <div class="ix-nav-right">
        <span class="ix-nav-note">Limited 1:1 sessions</span>
        <button type="button" class="ix-nav-cta" {...calTrigger}>Book a Session</button>
      </div>
    </nav>

    <main>
      <!-- ── Hero ─────────────────────────────────────────────── -->
      <header class="ix-hero">
        <p class="ix-eyebrow">Limited 1:1 Working Sessions</p>
        <h1 class="ix-h1">Let&rsquo;s Build Your Website Together</h1>
        <p class="ix-lede">
          Bring your website idea, existing page, or unfinished project. During a private working
          session, we&rsquo;ll use ChatGPT and Codex to turn it into something polished, functional,
          and ready to move forward.
        </p>
        <div class="ix-cta-row">
          <button type="button" class="ix-btn" {...calTrigger}>Book Your Session <span aria-hidden="true">&rarr;</span></button>
          <span class="ix-price-tag">${PRICE} &middot; 90 minutes</span>
        </div>
        <p class="ix-note">
          Limited availability &mdash; I only take a few of these a month.
          Questions first? <a href="mailto:me@amit.so" class="ix-inline-link">Email me</a> and I&rsquo;ll tell you if it&rsquo;s a fit.
        </p>
      </header>

      <!-- ── Choose your outcome ──────────────────────────────── -->
      <section class="ix-section" id="outcomes" aria-labelledby="outcomes-h">
        <p class="ix-kicker">01 &mdash; Choose your outcome</p>
        <h2 class="ix-h2" id="outcomes-h">You pick the one thing we build.</h2>
        <p class="ix-body">
          Every session is customized. Before we meet, you tell me the single outcome that matters
          most, and the whole 90 minutes points at it. Here&rsquo;s what people usually choose.
        </p>
        <ul class="ix-outcomes">
          {outcomes.map((item) => (
            <li class="ix-outcome">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- ── What's included ──────────────────────────────────── -->
      <section class="ix-section ix-section-dark" id="included" aria-labelledby="included-h">
        <p class="ix-kicker">02 &mdash; What is included</p>
        <h2 class="ix-h2" id="included-h">Everything that comes with the session.</h2>
        <ul class="ix-included">
          {included.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
        <div class="ix-price-card">
          <div>
            <p class="ix-price-label">The intensive</p>
            <p class="ix-price-figure">${PRICE}</p>
            <p class="ix-price-sub">One private 90-minute session, recording, master prompt, and seven days of follow-up.</p>
          </div>
          <button type="button" class="ix-btn ix-btn-invert" {...calTrigger}>Book Your Session <span aria-hidden="true">&rarr;</span></button>
        </div>
      </section>

      <!-- ── How it works ─────────────────────────────────────── -->
      <section class="ix-section" id="how" aria-labelledby="how-h">
        <p class="ix-kicker">03 &mdash; How it works</p>
        <h2 class="ix-h2" id="how-h">Four steps, start to finish.</h2>
        <ol class="ix-steps">
          {steps.map((step) => (
            <li>
              <span class="ix-step-n">{step.n}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── Expectation setting ──────────────────────────────── -->
      <section class="ix-section" id="scope" aria-labelledby="scope-h">
        <div class="ix-scope">
          <p class="ix-kicker ix-kicker-orange">Read this before you book</p>
          <h2 class="ix-h2 ix-h2-scope" id="scope-h">
            This is a collaborative website-building intensive. We will focus on one clearly defined
            priority during the session. It is not a done-for-you agreement to design and deliver an
            entire website.
          </h2>
          <p class="ix-body">
            You leave with real progress on the thing that matters most, plus the prompts and the plan
            to keep building on your own. You do not leave with a finished website I built for you.
            If that is what you need, don&rsquo;t book yet &mdash; <a href="mailto:me@amit.so" class="ix-inline-link">email me</a>
            and I&rsquo;ll tell you honestly whether this is the right fit.
          </p>
          <button type="button" class="ix-btn" {...calTrigger}>Book Your Session <span aria-hidden="true">&rarr;</span></button>
        </div>
      </section>

      <!-- ── Closing CTA ──────────────────────────────────────── -->
      <section class="ix-section ix-section-close" id="book" aria-labelledby="book-h">
        <p class="ix-kicker">Ready when you are</p>
        <h2 class="ix-h2" id="book-h">Pick a time and let&rsquo;s build.</h2>
        <p class="ix-body">
          Ninety minutes, one priority, your actual project. You&rsquo;ll get a short questionnaire
          right after booking so we open at full speed.
        </p>
        <div class="ix-cta-row">
          <button type="button" class="ix-btn" {...calTrigger}>Book Your Session <span aria-hidden="true">&rarr;</span></button>
          <span class="ix-price-tag">${PRICE} &middot; 90 minutes</span>
        </div>
        <p class="ix-note">
          Not sure it&rsquo;s the right fit? <a href="mailto:me@amit.so" class="ix-inline-link">Email me</a>
          with what you&rsquo;re working on and I&rsquo;ll tell you straight.
        </p>
      </section>
    </main>

    <footer class="ix-footer">
      <span>&copy; 2026 Amit Arora &middot; <a href="/">amit.so</a></span>
      <span>
        <a href="/interview">Book a call</a>
        <a href="/built">Built with Claude</a>
        <a href="/privacy">Privacy</a>
      </span>
    </footer>
  </div>

  <!-- Cal.com element-click embed: opens the booking + payment popup for any
       element carrying data-cal-link / data-cal-namespace (see calTrigger). -->
  <script is:inline>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "website-build-intensive", { origin: "https://app.cal.com" });
    Cal.config = Cal.config || {};
    Cal.config.forwardQueryParams = true;
    Cal.ns["website-build-intensive"]("ui", { "hideEventTypeDetails": false, "layout": "month_view" });
  </script>

</BaseLayout>
